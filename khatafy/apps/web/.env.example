# Copy this file to apps/web/.env  (same folder) and fill in the two required values.
# Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# the "anon" / "publishable" key. NEVER put the service_role / secret key here.
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# optional
VITE_SUPPORT_EMAIL=
# "Continue with Google" button is shown by default. Enable Google in Supabase -> Authentication -> Providers
# first, or set this to false to hide the button.
VITE_ENABLE_GOOGLE=true

# Shown in the Terms of Use / Privacy Policy pages. Fill these in before public launch.
VITE_COMPANY_NAME=Khatafy
VITE_COMPANY_ADDRESS=
VITE_GRIEVANCE_OFFICER=
# city whose courts have jurisdiction, e.g. Lucknow
VITE_JURISDICTION_CITY=
